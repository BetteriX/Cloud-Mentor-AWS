{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "denyec2Describe",
            "Effect": "Deny",
            "Action": [
                "ec2:Describe*"
            ],
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestedRegion": "eu-west-1"
                }
            }
        }
    ]
}