{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "denyS3FromInstanceIP",
            "Effect": "Deny",
            "Action": [
                "s3:Get*",
                "s3:List*"
            ],
            "Resource": "*",
            "Condition": {
                "IpAddress": {
                    "aws:SourceIp": "54.78.170.111/32"
                }
            }
        }
    ]
}